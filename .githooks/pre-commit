#!/bin/sh
# Local pre-commit gate. Bypass with `git commit --no-verify` if you must.

# Whitespace / merge-conflict-marker hygiene on all staged content.
if ! git diff --cached --check; then
  echo "Whitespace errors or merge-conflict markers in staged changes."
  exit 1
fi

# OKF conformance check on staged docs/ Markdown.
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/.*\.md$' || true)
[ -z "$staged" ] && exit 0

echo "OKF: linting staged docs..."
if ! node scripts/okf-lint.mjs $staged; then
  echo ""
  echo "OKF lint failed. Fix the issues above, or run 'npm run lint:okf' for the full report."
  echo "(To bypass in an emergency: git commit --no-verify)"
  exit 1
fi
