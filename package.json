{
  "name": "utk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "UTK — Universal Token Killer",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/plugins/agents/*",
    "packages/plugins/languages/*"
  ],
  "scripts": {
    "build": "npm run build -w @utk/foundation -w @utk/config -w @utk/grammar-dsl -w @utk/constrained-decoder -w @utk/tracing -w @utk/grammar -w @utk/detok -w @utk/minmap -w @utk/templates -w @utk/prompt-optimization -w @utk/context-optimization -w @utk/session-artifacts -w @utk/core -w @utk/tool-invocation -w @utk/code-graph -w @utk/codegen -w @utk-lang/typescript -w @utk/cli -w @utk/detok-mcp -w @utk/model-proxy -w @utk-agent/copilot -w @utk/evals",
    "postinstall": "node scripts/build-guidance-ts.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "npm run -ws test",
    "lint": "npm run lint:okf && npm run -ws lint",
    "lint:okf": "node scripts/okf-lint.mjs",
    "lint:okf:strict": "node scripts/okf-lint.mjs --strict",
    "docs:index": "node scripts/gen-okf-index.mjs",
    "typecheck": "npm run -ws typecheck",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@vitest/coverage-v8": "^4.1.6",
    "agentv": "^4.42.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
